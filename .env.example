# Bambola ortam degiskenleri.
# Bu dosyayi .env.local olarak kopyalayip doldurun. .env.local git'e girmez.

# --- Site ---
# Yayin adresi. Kanonik URL'ler, sitemap, robots ve OG kartlari bunu kullanir.
# Sonunda bolu isareti OLMAZ.
#
# Yayinda tanimlanmazsa Vercel'in kendi production adresine dusuyor
# (NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL). O da yoksa localhost kalir ve
# arama motoru siteyi erisilemez adreslerle indeksler; hicbir yerde hata
# vermez. Alan adi belli olunca burasi ve Vercel ortam degiskenleri doldurulur.
NEXT_PUBLIC_SITE_URL=http://localhost:3939

# --- Supabase ---
# Supabase panelinde Project Settings > API altinda.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# DIKKAT: service role anahtari RLS'i atlar. Yalniz sunucuda kullanilir,
# NEXT_PUBLIC_ onekiyle tanimlanmaz, tarayiciya asla gonderilmez.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (form bildirimi) ---
RESEND_API_KEY=
# Bildirimlerin gidecegi kurum adresi.
BILDIRIM_ALICI=
# Dogrulanmis gonderen adresi, ornek: kayit@alanadi.com
BILDIRIM_GONDEREN=

# --- Olcum (PLAN.md Bolum 12) ---
# Bos birakilirsa piksel hic yuklenmez.
NEXT_PUBLIC_META_PIXEL_ID=
